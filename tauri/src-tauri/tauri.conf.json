{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tern",
  "version": "0.1.0",
  "identifier": "fm.tern.app",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tern",
        "url": "http://127.0.0.1:18765/",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "resources": ["resources/**/*"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "REPLACE_WITH_GENERATED_PUBKEY",
      "endpoints": [
        "https://example.invalid/tern/latest.json"
      ]
    }
  }
}
